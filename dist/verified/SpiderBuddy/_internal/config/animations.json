{
  "default_fps": 12,
  "animations": {
    "idle": {
      "loop": true,
      "fps": 8,
      "description": "Standing and looking around breathing"
    },
    "walk": {
      "loop": true,
      "fps": 12,
      "description": "Walking along ground or window ledge"
    },
    "run": {
      "loop": true,
      "fps": 16,
      "description": "Fast running movement"
    },
    "jump": {
      "loop": false,
      "fps": 14,
      "description": "Leaping into the air"
    },
    "fall": {
      "loop": true,
      "fps": 12,
      "description": "Falling down with gravity"
    },
    "land": {
      "loop": false,
      "fps": 14,
      "description": "Landing on feet/crouch"
    },
    "climb_up": {
      "loop": true,
      "fps": 10,
      "description": "Climbing vertical wall or window edge"
    },
    "climb_down": {
      "loop": true,
      "fps": 10,
      "description": "Climbing down vertically"
    },
    "wall_slide": {
      "loop": true,
      "fps": 10,
      "description": "Sliding down a surface"
    },
    "perch": {
      "loop": true,
      "fps": 6,
      "description": "Crouched on window or screen corner"
    },
    "swing": {
      "loop": true,
      "fps": 14,
      "description": "Web swinging across screen"
    },
    "hang": {
      "loop": true,
      "fps": 6,
      "description": "Hanging upside down from ceiling or top bar"
    },
    "sleep": {
      "loop": true,
      "fps": 4,
      "description": "Sleeping curled up or in a web hammock"
    },
    "interact": {
      "loop": false,
      "fps": 12,
      "description": "Reaction to mouse click or poke"
    },
    "dragged": {
      "loop": true,
      "fps": 12,
      "description": "Dangling when held and dragged by mouse"
    }
  }
}
